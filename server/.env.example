# Copy to .env for local development. Never commit real values.

# "mongo" needs MONGODB_URI; "memory" runs without a database (data is lost on restart).
STORE=memory
MONGODB_URI=
# Long random string, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=
PORT=4000
# Browser origins allowed to open a socket (comma-separated).
CLIENT_ORIGIN=http://localhost:5173
# Proxies between the browser and this server (Vercel rewrite + Render = 2 in production).
TRUST_PROXY_HOPS=1
# Sign-in / sign-up / demo attempts per IP per minute.
AUTH_RATE_LIMIT=20

# AI (optional). With neither key set, "Break down a goal", "Summarise" and the standup use the built-in planner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Defaults: claude-haiku-5-5 (Anthropic) or gpt-5-mini (OpenAI)
AI_MODEL=
# Model calls per user per day; template answers are unlimited.
AI_DAILY_LIMIT=40
